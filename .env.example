# ── LLM Providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free

# Groq (recommended — used for strategy narrative + /api/chat)
GROQ_API_KEY=gsk_...

# ── Angel One SmartAPI (primary data provider for NSE/BSE) ───────────────────
# Register at: https://smartapi.angelbroking.com/
# TOTP secret: scan the QR code from your Angel One app with pyotp/Google Auth
ANGELONE_API_KEY=your_api_key_here
ANGELONE_CLIENT_ID=your_client_id_here        # e.g. A12345
ANGELONE_PASSWORD=your_trading_password_here
ANGELONE_TOTP_SECRET=your_base32_totp_secret  # optional but strongly recommended

# ── Legacy / Fallback ────────────────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Backtest defaults ────────────────────────────────────────────────────────
BACKTEST_DEFAULT_CAPITAL=100000
BACKTEST_COMMISSION_PCT=0.001
BACKTEST_SLIPPAGE_PCT=0.0005
BACKTEST_DEFAULT_ASSET=RELIANCE

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
admin_email=admin@iris.local
admin_password=ChangeMe123!
